rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global lock
    match /{document=**} {
      allow read, write: if false;
    }

    match /jamaahContainer/{documentId} { allow read, write: if true; }
    match /rooms_v2/{roomId} { allow read, write: if true; }
    match /documents_v2/{docId} { allow read, write: if true; }
    match /broadcasts/{broadcastId} { allow read, write: if true; }
    match /dutyTasks_v2/{taskId} { allow read, write: if true; }
    match /wallets_v2/{walletId} { allow read, write: if true; }
    match /expenses_v2/{expenseId} { allow read, write: if true; }
    match /transactions_v2/{transactionId} { allow read, write: if true; }
    match /sops_v2/{sopId} { allow read, write: if true; }
    match /teamMembers_v2/{memberId} { allow read, write: if true; }
    match /packages_v2/{pkgId} { allow read, write: if true; }
    match /hotelInfos_v2/{hotelId} { allow read, write: if true; }
    match /groups_v2/{groupId} { allow read, write: if true; }
    match /taskChecklists_v2/{checklistId} { allow read, write: if true; }
    match /jamaahList_v2/{jamaahId} { allow read, write: if true; }
    match /itineraries_v2/{itineraryId} { allow read, write: if true; }
    match /attendanceLogs_v2/{logId} { allow read, write: if true; }
    match /incidentLogs_v2/{logId} { allow read, write: if true; }
    match /walkie_rooms/{roomId} { allow read, write: if true; }
    
    // Legacy support just in case
    match /rooms/{roomId} { allow read, write: if true; }
    match /documents/{docId} { allow read, write: if true; }
    match /dutyTasks/{taskId} { allow read, write: if true; }
    match /wallets/{walletId} { allow read, write: if true; }
    match /expenses/{expenseId} { allow read, write: if true; }
    match /transactions/{transactionId} { allow read, write: if true; }
    match /sops/{sopId} { allow read, write: if true; }
    match /teamMembers/{memberId} { allow read, write: if true; }
    match /packages/{pkgId} { allow read, write: if true; }
    match /hotelInfos/{hotelId} { allow read, write: if true; }
    match /groups/{groupId} { allow read, write: if true; }
    match /taskChecklists/{checklistId} { allow read, write: if true; }
    match /jamaahList/{jamaahId} { allow read, write: if true; }
    match /itineraries/{itineraryId} { allow read, write: if true; }
    match /attendanceLogs/{logId} { allow read, write: if true; }
    match /incidentLogs/{logId} { allow read, write: if true; }
  }
}
